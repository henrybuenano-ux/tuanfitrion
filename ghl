#!/usr/bin/env python3
"""ghl — a small command-line client for the GoHighLevel / LeadConnector API v2.

Authentication uses a Bearer token (a Private Integration Token "pit-..." or an
OAuth access token) plus a Location ID. Credentials are resolved, in order, from:

  1. command-line flags  (--token / --location)
  2. environment vars    (GHL_TOKEN / GHL_LOCATION_ID)
  3. a config file       (./.ghl/config.json  or  ~/.config/ghl/config.json)

Run `./install.sh` once to write the config file, then use commands such as:

  ghl contacts list --limit 5
  ghl workflows list
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

API_BASE = "https://services.leadconnectorhq.com"
API_VERSION = "2021-07-28"
# A browser-like User-Agent is required: the default urllib UA is blocked by the
# API's Cloudflare edge (Error 1010 "browser_signature_banned").
USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
)

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATHS = [
    os.path.join(SCRIPT_DIR, ".ghl", "config.json"),
    os.path.expanduser("~/.config/ghl/config.json"),
]


# --------------------------------------------------------------------------- #
# Config / credentials
# --------------------------------------------------------------------------- #
def load_config():
    """Return the first config file found, merged with environment variables."""
    cfg = {}
    for path in CONFIG_PATHS:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    cfg = json.load(fh)
                cfg["_source"] = path
            except (OSError, ValueError) as exc:
                die(f"could not read config file {path}: {exc}")
            break
    return cfg


def resolve_credentials(args):
    """Resolve (token, location) with precedence: flags > config file > env vars.

    The config file written by install.sh wins over environment variables on
    purpose: a Private Integration Token is bound to one location, so an ambient
    GHL_LOCATION_ID from a different account must not silently override the
    matched pair the installer saved. Environment variables still apply when a
    field is absent from the config file (e.g. CI with no config file).
    """
    cfg = load_config()
    token = args.token or cfg.get("token") or os.environ.get("GHL_TOKEN")
    location = (
        args.location
        or cfg.get("location_id")
        or os.environ.get("GHL_LOCATION_ID")
    )
    if not token:
        die(
            "no API token found. Provide --token, set GHL_TOKEN, or run ./install.sh "
            "to create a config file."
        )
    return token, location, cfg


# --------------------------------------------------------------------------- #
# HTTP
# --------------------------------------------------------------------------- #
def api_get(path, params, token):
    url = API_BASE + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, method="GET")
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("Version", API_VERSION)
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", USER_AGENT)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")
        try:
            detail = json.dumps(json.loads(body), indent=2)
        except ValueError:
            detail = body
        hint = ""
        if exc.code in (401, 403):
            hint = "\n  → the token may be invalid/expired or lack the required scope."
        elif exc.code == 422:
            hint = "\n  → check the Location ID (locationId) and query parameters."
        die(f"API request failed: HTTP {exc.code} {exc.reason}\nGET {url}\n{detail}{hint}")
    except urllib.error.URLError as exc:
        die(
            f"could not reach the GoHighLevel API at {API_BASE}\nGET {url}\n"
            f"  reason: {exc.reason}\n"
            "  → this environment may not allow outbound network access to that host."
        )


# --------------------------------------------------------------------------- #
# Output helpers
# --------------------------------------------------------------------------- #
def print_json(obj):
    print(json.dumps(obj, indent=2, ensure_ascii=False))


def print_table(rows, headers):
    """rows: list of lists (already stringified). headers: list of str."""
    if not rows:
        print("(no results)")
        return
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    line = "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers))
    print(line)
    print("  ".join("-" * widths[i] for i in range(len(headers))))
    for row in rows:
        print("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)))


def s(value):
    """Stringify a cell value, collapsing None/empty to a dash."""
    if value is None or value == "":
        return "-"
    return str(value)


def require_location(location):
    if not location:
        die(
            "no Location ID found. Provide --location, set GHL_LOCATION_ID, or add "
            "location_id to the config file."
        )


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #
def cmd_contacts_list(args):
    token, location, _ = resolve_credentials(args)
    require_location(location)
    params = {"locationId": location, "limit": args.limit}
    if args.query:
        params["query"] = args.query
    data = api_get("/contacts/", params, token)
    if args.json:
        print_json(data)
        return
    contacts = data.get("contacts", [])
    rows = []
    for c in contacts:
        name = c.get("contactName") or " ".join(
            p for p in [c.get("firstName"), c.get("lastName")] if p
        )
        rows.append([s(c.get("id")), s(name), s(c.get("email")), s(c.get("phone"))])
    print_table(rows, ["ID", "NAME", "EMAIL", "PHONE"])
    total = (data.get("meta") or {}).get("total")
    print(f"\nShowing {len(rows)} contact(s)" + (f" of {total} total." if total is not None else "."))


def cmd_contacts_get(args):
    token, _, _ = resolve_credentials(args)
    data = api_get(f"/contacts/{args.id}", {}, token)
    print_json(data)


def cmd_workflows_list(args):
    token, location, _ = resolve_credentials(args)
    require_location(location)
    data = api_get("/workflows/", {"locationId": location}, token)
    if args.json:
        print_json(data)
        return
    workflows = data.get("workflows", [])
    rows = [
        [s(w.get("id")), s(w.get("name")), s(w.get("status"))]
        for w in workflows
    ]
    print_table(rows, ["ID", "NAME", "STATUS"])
    print(f"\nShowing {len(rows)} workflow(s).")


def cmd_config_show(args):
    token, location, cfg = resolve_credentials(args)
    redacted = (token[:7] + "…" + token[-4:]) if len(token) > 12 else "set"
    print(f"token       : {redacted}")
    print(f"location_id : {location or '(not set)'}")
    print(f"config file : {cfg.get('_source', '(none — using flags/env)')}")
    print(f"api base    : {API_BASE}")
    print(f"api version : {API_VERSION}")


# --------------------------------------------------------------------------- #
# Plumbing
# --------------------------------------------------------------------------- #
def die(msg, code=1):
    print(f"ghl: error: {msg}", file=sys.stderr)
    sys.exit(code)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ghl",
        description="Command-line client for the GoHighLevel / LeadConnector API v2.",
    )
    parser.add_argument("--token", help="Bearer token (PIT or OAuth access token).")
    parser.add_argument("--location", help="GoHighLevel Location ID.")
    parser.add_argument("--json", action="store_true", help="Print raw JSON response.")

    sub = parser.add_subparsers(dest="group", required=True)

    # contacts
    contacts = sub.add_parser("contacts", help="Manage contacts.")
    contacts_sub = contacts.add_subparsers(dest="action", required=True)
    c_list = contacts_sub.add_parser("list", help="List contacts.")
    c_list.add_argument("--limit", type=int, default=20, help="Max results (default 20).")
    c_list.add_argument("--query", help="Search query (name, email, phone).")
    c_list.set_defaults(func=cmd_contacts_list)
    c_get = contacts_sub.add_parser("get", help="Get a single contact by ID.")
    c_get.add_argument("id", help="Contact ID.")
    c_get.set_defaults(func=cmd_contacts_get)

    # workflows
    workflows = sub.add_parser("workflows", help="Manage workflows.")
    workflows_sub = workflows.add_subparsers(dest="action", required=True)
    w_list = workflows_sub.add_parser("list", help="List workflows.")
    w_list.set_defaults(func=cmd_workflows_list)

    # config
    config = sub.add_parser("config", help="Inspect the resolved configuration.")
    config_sub = config.add_subparsers(dest="action", required=True)
    cfg_show = config_sub.add_parser("show", help="Show resolved config (token redacted).")
    cfg_show.set_defaults(func=cmd_config_show)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(2)
    args.func(args)


if __name__ == "__main__":
    main()
